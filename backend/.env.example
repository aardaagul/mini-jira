# Örnek ortam değişkenleri dosyası.
# Kullanmak için bu dosyayı ".env" olarak kopyalayın ve değerleri ortamınıza göre güncelleyin.

# JWT imzalama anahtarı (üretimde mutlaka değiştirin!)
SECRET_KEY=mini_jira_super_secret_jwt_key_2026_secure_token
ALGORITHM=HS256
# Token geçerlilik süresi (dakika). 10080 = 7 gün
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Veritabanı bağlantısı (PostgreSQL). Yerel Docker kurulumu için:
DATABASE_URL=postgresql+psycopg://jira_user:jira_password@localhost:5432/minijira
